<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Minimal quality gate for car-rental-service.
  Every rule is an error: a violation fails `checkstyleMain` / `checkstyleTest`.
  Local exceptions must use @SuppressWarnings("checkstyle:<rule>") with a comment
  explaining why; never disable a rule globally to make the build green.
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Long lines hurt review in side-by-side diffs. -->
    <module name="LineLength">
        <property name="max" value="120"/>
        <property name="ignorePattern" value="^(package|import) .*$"/>
    </module>

    <module name="FileTabCharacter"/>

    <module name="SuppressWarningsFilter"/>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- Imports -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <!-- Static star imports stay allowed: `Assertions.*`, `Mockito.*` and
             `MockMvcRequestBuilders.*` are the idiomatic style of JUnit/MockMvc tests. -->
        <module name="AvoidStarImport">
            <property name="allowStaticMemberImports" value="true"/>
        </module>

        <!-- Blocks: braces are mandatory, empty statements are forbidden -->
        <module name="NeedBraces"/>
        <module name="EmptyStatement"/>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>

        <!-- Cheap correctness checks -->
        <module name="EqualsHashCode"/>
        <module name="OneStatementPerLine"/>
    </module>
</module>
